@using Newtonsoft.Json
@using Microsoft.AspNetCore.Mvc.Rendering
@model List<TopScorer>

<div class="hero-section mb-4">
    <div class="container">
        <h1 class="hero-title">Leagues & Top Scorers</h1>
        <p class="hero-subtitle">Browse standings by league and track the current goal kings.</p>
    </div>
</div>

<div class="container mb-5">
    <div class="row g-4">

        <!-- League Table (left) -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white d-flex align-items-center">
                    <i class="bi bi-trophy-fill me-2"></i>
                    <h5 class="mb-0">League Standings</h5>
                </div>
                <div class="card-body p-0">
                    @await Component.InvokeAsync("League", new { SelectedLeague = Context.Request.Query["SelectedLeague"].ToString() })
                </div>
            </div>
        </div>

        <!-- Sidebar (right) -->
        <div class="col-lg-4">

            <!-- Top Scorers -->
            <div class="card shadow-sm border-0 mb-3">
                <div class="card-header bg-warning text-dark d-flex align-items-center py-2">
                    <i class="bi bi-star-fill me-2"></i>
                    <h6 class="mb-0 fw-bold">Top Scorers</h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive" style="max-height: 250px; overflow-y: auto;">
                        <table class="table table-hover table-borderless text-center mb-0" style="font-size: 0.85rem;">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th>Name</th>
                                    <th>Goals</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    @foreach (var player in Model)
                                    {
                                        <tr class="align-middle border-bottom">
                                            <td class="text-start ps-3"><strong>@player.name</strong></td>
                                            <td class="fw-bold text-primary">@player.goals</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="2" class="text-muted py-2">No data available.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Add Comment -->
            <div class="card shadow-sm border-0 mb-3">
                <div class="card-header bg-primary text-white d-flex align-items-center py-2">
                    <i class="bi bi-chat-dots-fill me-2"></i>
                    <h6 class="mb-0 fw-bold">Add a Comment</h6>
                </div>
                <div class="card-body py-2 px-3">
                    @if (User?.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <div class="d-flex align-items-center mb-2">
                            <img src="@ViewBag.ProfilePhoto" alt="Profile" class="rounded-circle"
                                 style="width: 32px; height: 32px; object-fit: cover;"
                                 onerror="this.src='/images/default-profile.png';">
                            <span class="fw-semibold ms-2" style="font-size: 0.85rem;">@User.Identity.Name</span>
                        </div>

                        <form id="CommentForm" asp-action="Index" asp-controller="League" method="post">
                            <div class="mb-2">
                                <textarea name="Text" class="form-control form-control-sm" placeholder="Write something..." rows="2" required style="font-size: 0.85rem;"></textarea>
                            </div>

                            <div class="row g-2 mb-2">
                                <div class="col-6">
                                    <select id="CommentType" name="CommentType" class="form-select form-select-sm" onchange="updateTargetOptions()" required style="font-size: 0.8rem;">
                                        <option value="league">League</option>
                                        <option value="player">Scorer</option>
                                        <option value="team">Team</option>
                                    </select>
                                </div>
                                <div class="col-6">
                                    <select id="CommentTargetGol" name="CommentTargetGol" class="form-select form-select-sm" required style="font-size: 0.8rem;"></select>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary w-100 btn-sm" style="font-size: 0.8rem;">
                                <i class="bi bi-send-fill me-1"></i> Submit
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="text-center py-3">
                            <i class="bi bi-lock-fill text-muted" style="font-size: 1.5rem;"></i>
                            <p class="mt-2 mb-2 text-muted" style="font-size: 0.8rem;">Please login to comment.</p>
                            <a asp-action="Login" asp-controller="User" class="btn btn-outline-primary btn-sm">Login</a>
                        </div>
                    }
                </div>
            </div>

            <!-- Recent Comments -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-secondary text-white d-flex align-items-center py-2">
                    <i class="bi bi-chat-left-text-fill me-2"></i>
                    <h6 class="mb-0 fw-bold">Recent Comments</h6>
                </div>
                <div class="card-body py-2 px-3">
                    <div class="mb-2">
                        <select id="CommentTypeFilter" class="form-select form-select-sm" style="font-size: 0.8rem;">
                            <option value="league">League</option>
                            <option value="player">Scorer</option>
                            <option value="team">Team</option>
                        </select>
                    </div>
                    <div id="commentContainer" style="max-height: 300px; overflow-y: auto;">
                        @await Component.InvokeAsync("Comment", new { type = "league" })
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const dropdown = document.getElementById("CommentTypeFilter");

            function loadComments(type) {
                fetch(`/League/LoadComments?type=${type}`)
                    .then(response => response.text())
                    .then(html => {
                        document.getElementById("commentContainer").innerHTML = html;
                    })
                    .catch(error => {
                        console.error("Yorumlar yüklenemedi:", error);
                    });
            }

            dropdown.addEventListener("change", function () {
                loadComments(this.value);
            });
        });
    </script>

    <script>
        const playerList = @Html.Raw(JsonConvert.SerializeObject(
            ((ViewBag.YorumGolk as SelectList) ?? new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"))
            .Select(i => new { value = i.Value, text = i.Text })
        ));

        const TeamList = @Html.Raw(JsonConvert.SerializeObject(
            ((ViewBag.TeamList as SelectList) ?? new SelectList(Enumerable.Empty<SelectListItem>(), "Value", "Text"))
            .Select(i => new { value = i.Value, text = i.Text })
        ));

        const selectedLeagueValue = @Html.Raw(JsonConvert.SerializeObject(ViewBag.Lig?.ToString()));

        function updateTargetOptions() {
            const typeInput = document.getElementById("CommentType");
            const targetSelect = document.getElementById("CommentTargetGol");
            
            // Login olunmadığında bu elementler render edilmez, bu yüzden işlem yapmadan çıkıyoruz
            if (!typeInput || !targetSelect) return;

            const type = typeInput.value;
            targetSelect.innerHTML = "";

            let options = [];

            if (type === "player") options = playerList;
            else if (type === "team") options = TeamList;
            else if (type === "league") {
                options = [{
                    value: selectedLeagueValue,
                    text: selectedLeagueValue
                }];
            }

            options.forEach(function (item) {
                const opt = document.createElement("option");
                opt.value = item.value;
                opt.textContent = item.text;
                targetSelect.appendChild(opt);
            });
        }

        document.addEventListener("DOMContentLoaded", updateTargetOptions);
    </script>
}