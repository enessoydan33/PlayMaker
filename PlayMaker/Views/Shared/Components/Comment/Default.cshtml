@model GetCommentTarget

@if (Model.Comments == null || !Model.Comments.Any())
{
    <div class="text-center text-muted">No comments found for @Model.Type.</div>
}
else
{
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }


    <div class="card-header bg-black text-white text-center">
        <h5 class="mb-0">@Model.Type.ToUpper()</h5>
    </div>
    <div class="p-3">
        @foreach (var comment in Model.Comments)
        {
            <div class="card mb-4 shadow-sm border-0" style="border-radius: 14px;">
                <div class="card-body d-flex align-items-start gap-3 p-3">
                    <!-- Profil Fotoğrafı -->
                  
                       <img src="@comment.User?.ProfilePictureUrl"
                            alt="profile"
                            class="rounded-circle border"
                            style="width: 56px; height: 56px; object-fit: cover;"
                            onerror="this.src='/images/default-profile.png';">
                     
                       <!-- Yorum İçeriği -->
                       <div class="flex-grow-1">
                           <!-- Kullanıcı adı ve tarih -->
                           <div class="d-flex justify-content-between align-items-center mb-1">
                               <h5 class="mb-0 fw-semibold">@comment.User?.UserName</h5>
                               <span class="text-muted" style="font-size: 0.95rem;">@comment.Date.ToString("dd.MM.yyyy HH:mm")</span>
                           </div>

                           <!-- Yorum metni -->
                           <p class="mb-3 mt-2 fs-6 text-body">@comment.Text</p>

                           <!-- Tepki ikonları -->
                           <div class="d-flex align-items-center gap-4 fs-5">
                               <form asp-action="Like" asp-controller="User" method="post">
                                   <input type="hidden" name="id" value="@comment.Id" />
                                   <button type="submit" class="btn btn-link text-success">
                                       <i class="bi bi-hand-thumbs-up-fill me-1"></i>@comment.Likes.Count
                                   </button>
                               </form>
                               <form asp-action="DissLike" asp-controller="User" method="post">
                                   <input type="hidden" name="id" value="@comment.Id" />
                                   <button type="submit" class="btn btn-link text-danger">
                                       <i class="bi bi-hand-thumbs-down-fill me-1"></i>@comment.Dislikes.Count
                                   </button>
                               </form>
                           </div>
                       </div>
</div>
            </div>


        }
    </div>
}

