@{
    ViewBag.Title = "Transfer Haberleri";
}
@model List<NewsItem>


<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

<div class="container mt-4">
    <!-- Transfer Haberleri Başlık -->
    <div class="card shadow-sm border-0 p-4 text-center">
        <h2 class="mb-3"><i class="bi bi-newspaper"></i> NEWS</h2>

        

    <!-- Transfer Haberleri -->

    <div class="row g-3">
        @foreach (var news in Model)
        {
            <div class="col-md-4">
                <div class="card news-card">
                    <img src="@news.ImageUrl" class="card-img-top" alt="Transfer Haberi" onerror="this.src='https://via.placeholder.com/300'">
                    <div class="card-body">
                        <h5 class="card-title">@news.Title</h5>
                        <p class="card-text text-muted">@news.SourceStr</p>
                        <a href="@news.PageUrl" class="btn btn-sm btn-outline-primary" target="_blank">Detayları Oku</a>
                    </div>
                </div>
            </div>
        }
    </div>

   