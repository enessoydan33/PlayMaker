@model UserEditprofileViewModel


@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="row g-4 justify-content-center">
    <!-- League Standings -->
    @* @await Component.InvokeAsync("League")

    *@

    <div class="card p-4 shadow-lg" style="width: 100%; max-width: 500px;">
        <h2 class="text-center mb-4">Edit Profile</h2>

        <form asp-action="EditProfile" method="post" enctype="multipart/form-data">
            <div class="mb-3">
                <label class="form-label">Username</label>
                <input asp-for="UserName" class="form-control" />
            </div>

            <div class="mb-3 text-center">
                <label class="form-label d-block">Profile Photo</label>
                @if (!string.IsNullOrEmpty(Model.ExistingProfilePhotoPath))
                {
                    <img src="@Model.ExistingProfilePhotoPath" alt="Profile" class="rounded-circle mb-2" width="100" height="100" />
                }
                <input asp-for="ProfileImage" type="file" class="form-control" />
            </div>

            <hr />
            <h5 class="mb-3 text-center">Change Password</h5>

            <div class="mb-3">
                <label>Current Password</label>
                <input asp-for="CurrentPassword" class="form-control" type="password" autocomplete="new-password" />
            </div>

            <div class="mb-3">
                <label>New Password</label>
                <input asp-for="NewPassword" class="form-control" type="password" autocomplete="new-password" />
            </div>

            <div class="mb-4">
                <label>Confirm New Password</label>
                <input asp-for="ConfirmPassword" class="form-control" type="password" autocomplete="new-password" />
            </div>

            <button type="submit" class="btn btn-success w-100">Save</button>
        </form>
    </div>
    <!-- Live Score -->
    @* @await Component.InvokeAsync("Score")*@
</div>
