@model List<ProfileCommentViewModel>

@{
    ViewBag.Title = "Kullanıcı Yorumları";
}

<div class="container profile-container">
    <!-- Kullanıcı Profil Bilgileri -->
    <div class="profile-header">
        <img src="@ViewBag.ProfilePhoto" alt="Profil Fotoğrafı"
             class="profile-avatar"
             onerror="this.src='/uploads/dfd.jpg';"
             title="Profil Fotoğrafı">
        <h3>@User.Identity.Name</h3>
    </div>

    <!-- Kullanıcı Yorumları Başlığı -->
    <h2 class="mb-3">@User.Identity.Name Comments</h2>

    @foreach (var comment in Model)
    {
        <div class="comment-card">
            <div class="comment-header">
                <span>
                    <i class="fas fa-comment"></i>
                    @if (comment.Type == "Team")
                    {
                        <span>Team: @comment.TeamName</span>
                    }
                    else if (comment.Type == "League")
                    {
                        <span>League: @comment.LeagueName</span>
                    }
                </span>
                <span>
                    <i class="far fa-calendar-alt"></i> @comment.Date.ToString("dd MMM yyyy")
                </span>
            </div>
            <div class="comment-body">
                <p>@comment.Text</p>
                <div class="d-flex justify-content-between align-items-center mt-3">
                    <span class="badge bg-primary">@comment.Type</span>
                    <div>
                        <button class="btn btn-sm btn-outline-primary" type="button" title="Beğen">
                            <i class="far fa-thumbs-up"></i> @comment.LikeCount
                        </button>
                        <button class="btn btn-sm btn-outline-danger" type="button" title="Beğenme">
                            <i class="far fa-thumbs-down"></i> @comment.DislikeCount
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
<style>
    body {
        background-color: #f0f2f5;
        padding-top: 30px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: #333;
    }

    .profile-container {
        max-width: 720px;
        margin: 0 auto;
        padding: 0 15px;
    }

    .profile-header {
        background-color: #fff;
        border-radius: 15px;
        padding: 25px 30px;
        box-shadow: 0 6px 15px rgba(0, 0, 0, 0.1);
        margin-bottom: 40px;
        display: flex;
        align-items: center;
        gap: 20px;
        transition: box-shadow 0.3s ease;
    }

    .profile-header:hover {
        box-shadow: 0 8px 20px rgba(74, 144, 226, 0.3);
    }

    .profile-header img {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid #4a90e2;
        box-shadow: 0 4px 12px rgba(74, 144, 226, 0.5);
        transition: transform 0.3s ease;
    }

    .profile-header img:hover {
        transform: scale(1.1);
    }

    .profile-header h3 {
        font-weight: 700;
        font-size: 1.8rem;
        margin: 0;
        user-select: none;
    }

    h2.mb-3 {
        font-weight: 600;
        color: #444;
        margin-bottom: 30px;
        border-bottom: 2px solid #4a90e2;
        padding-bottom: 8px;
        user-select: none;
    }

    .comment-card {
        background-color: #fff;
        border-radius: 15px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.07);
        margin-bottom: 25px;
        transition: box-shadow 0.3s ease;
        overflow: hidden;
        border: 1px solid #ddd;
    }

    .comment-card:hover {
        box-shadow: 0 8px 30px rgba(74, 144, 226, 0.25);
        border-color: #4a90e2;
    }

    .comment-header {
        background: linear-gradient(90deg, #4a90e2 0%, #357ABD 100%);
        color: white;
        padding: 15px 20px;
        font-weight: 600;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-top-left-radius: 15px;
        border-top-right-radius: 15px;
        font-size: 1rem;
        user-select: none;
    }

    .comment-header i {
        margin-right: 8px;
    }

    .comment-body {
        padding: 20px 25px;
        color: #444;
        font-size: 1.05rem;
        line-height: 1.5;
        position: relative;
    }

    .comment-body p {
        margin: 0;
    }

    .badge.bg-primary {
        background-color: #4a90e2;
        font-weight: 600;
        font-size: 0.85rem;
        padding: 6px 14px;
        border-radius: 20px;
        text-transform: uppercase;
        user-select: none;
    }

    .btn-outline-primary, .btn-outline-danger {
        font-weight: 600;
        font-size: 0.9rem;
        border-width: 2px;
        transition: all 0.25s ease;
        min-width: 80px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
    }

    .btn-outline-primary {
        color: #4a90e2;
        border-color: #4a90e2;
    }

    .btn-outline-primary:hover {
        background-color: #4a90e2;
        color: white;
        box-shadow: 0 4px 10px rgba(74, 144, 226, 0.4);
    }

    .btn-outline-danger {
        color: #e74c3c;
        border-color: #e74c3c;
    }

    .btn-outline-danger:hover {
        background-color: #e74c3c;
        color: white;
        box-shadow: 0 4px 10px rgba(231, 76, 60, 0.4);
    }

    .fas, .far {
        font-size: 1.1rem;
        vertical-align: middle;
    }

    }
</style>
