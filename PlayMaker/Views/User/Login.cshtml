@{
    ViewBag.Title = "Login";
}
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

@model UserLoginViewModel

<div class="container mt-4">
    <div class="row g-4 justify-content-center">



        <!-- Log In Form -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 p-4">
                <h3 class="text-success text-center"><i class="bi bi-box-arrow-in-right"></i> Log In</h3>
                <form asp-action="Login" asp-controller="User" method="post">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-bold">Email</label>
                        <input asp-for="Email" class="form-control form-control-lg">
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-bold">Password</label>
                        <input asp-for="Password" type="password" class="form-control form-control-lg">
                    </div>
                    <div class="text-center">
                        <button type="submit" class="btn btn-success px-4 py-2">Login</button>
                    </div>
                    <div class="text-center mt-2">
                        <a href="#" class="text-muted">Forgot Password?</a>
                    </div>
                </form>
            </div>
        </div>



    </div>
</div>
