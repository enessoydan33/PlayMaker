@{
    ViewBag.Title = "Sign Up";
}
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

@model UserIndexViewModel

<div class="container mt-4">
    <div class="row g-4 justify-content-center">

        
        <!-- Sign Up Form -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 p-4">
                <h3 class="text-success text-center"><i class="bi bi-person-plus-fill"></i> Sign Up</h3>
                <form asp-action="Index" asp-controller="User" method="post">
                    <div asp-validation-summary="All" class="text-danger"></div>
                    <div class="mb-3">
                        <label asp-for="UserName" class="form-label fw-bold">Username</label>
                        <input asp-for="UserName" class="form-control form-control-lg">
                    </div>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-bold">Email</label>
                        <input asp-for="Email" class="form-control form-control-lg">
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-bold">Password</label>
                        <input asp-for="Password" type="password" class="form-control form-control-lg">
                    </div>
                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label fw-bold">Confirm Password</label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control form-control-lg">
                    </div>
                    <div class="text-center">
                        <button type="submit" class="btn btn-success px-4 py-2">Sign Up</button>
                    </div>
                </form>
            </div>
        </div>


        
    </div>
</div>
